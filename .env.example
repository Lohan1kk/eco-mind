# EcoMind — variáveis de ambiente (copie para .env.local)

# Opcional: chave NASA FIRMS (MAP KEY)
# Obtenha em: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Sem chave o app já usa os CSVs públicos globais da NASA.
# Com chave: reforço de focos no Brasil via API por área.
FIRMS_MAP_KEY=

# Exemplo:
# FIRMS_MAP_KEY=sua_chave_aqui
